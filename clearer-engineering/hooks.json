{
  "ceh-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/clearer-engineering/scripts/safety-gate.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/clearer-engineering/scripts/safety-gate.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/clearer-engineering/scripts/safety-gate.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/clearer-engineering/scripts/safety-gate.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "ceh-stop-guard": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"$HOME/.gemini/config/plugins/clearer-engineering/scripts/ceh-stop-guard.py\"",
        "timeout": 10
      }
    ]
  }
}

